{
  "name": "memoryloupe",
  "publisher": "plharraud",
  "displayName": "memoryloupe - in-editor code size insights",
  "description": "provide codelenses about compiled executable symbol size and stack usage",
  "keywords": [
    "symbol",
    "size",
    "stack",
    "usage",
    "map",
    "gcc"
  ],
  "license": "MIT",
  "homepage": "https://github.com/plharraud/memoryloupe",
  "repository": {
    "type": "git",
    "url": "https://github.com/plharraud/memoryloupe"
  },
  "bugs": {
    "url": "https://github.com/plharraud/memoryloupe/issues"
  },
  "extensionKind": [
    "workspace"
  ],
  "pricing": "Free",
  "version": "1.3.0",
  "private": true,
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Visualization",
    "Debuggers"
  ],
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "memoryloupe.selectBuildDir",
        "title": "memoryloupe: Select build directory"
      },
      {
        "command": "memoryloupe.toggleCodeLenses",
        "title": "memoryloupe: Toggle codelenses"
      }
    ],
    "configuration": {
      "properties": {
        "memoryloupe.buildDir": {
          "type": "string",
          "description": "Directory to look for .map and .su files"
        },
        "memoryloupe.lenseFormat": {
          "type": "string",
          "default": "size: %size, stack: %stack, %address %status",
          "description": "Custom codelense format string, available values: %name, %section, %address, %size, %status, %stack"
        },
        "memoryloupe.codeLensesEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Show codelenses next to symbols in source files"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "vsix": "npx vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.86.0",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.2",
    "esbuild": "^0.24.2",
    "eslint": "^9.19.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.3"
  }
}