{
  "name": "memoryloupe",
  "publisher": "plharraud",
  "displayName": "MemoryLoupe - in-editor code size insights",
  "description": "codelenses about compiled executable symbol size and stack usage",
  "keywords": [
    "symbol",
    "size",
    "stack",
    "usage",
    "map",
    "gcc"
  ],
  "license": "MIT",
  "homepage": "https://github.com/plharraud/memoryloupe",
  "repository": {
    "type": "git",
    "url": "https://github.com/plharraud/memoryloupe"
  },
  "bugs": {
    "url": "https://github.com/plharraud/memoryloupe/issues"
  },
  "extensionKind": [
    "workspace"
  ],
  "pricing": "Free",
  "version": "1.4.0",
  "private": true,
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Visualization",
    "Debuggers"
  ],
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "memoryloupe.selectBuildDir",
        "title": "memoryloupe: Select build directory"
      },
      {
        "command": "memoryloupe.toggleCodeLenses",
        "title": "memoryloupe: Toggle codelenses"
      },
      {
        "command": "memoryloupe.goToSymbolSourcefile",
        "icon": "$(file)",
        "title": "Go to symbol in source file"
      },
      {
        "command": "memoryloupe.goToSymbolMapfile",
        "icon": "$(file-binary)",
        "title": "Go to symbol in .map file"
      },
      {
        "command": "memoryloupe.refreshTreeview",
        "icon": "$(refresh)",
        "title": "Refresh tree view"
      },
      {
        "command": "memoryloupe.openMapfile",
        "icon": "$(file-binary)",
        "title": "Go to .map file"
      }
    ],
    "configuration": {
      "properties": {
        "memoryloupe.buildDir": {
          "type": "string",
          "description": "Directory to look for .map and .su files"
        },
        "memoryloupe.lenseFormat": {
          "type": "string",
          "default": "${section} $[size: ]{size} $[stack: ]{stack} ${address} ${status}",
          "description": "Custom codelense format string. Specify optional prefix with $[prefix]{value}\nAvailable values: name, section, address, size, status, stack"
        },
        "memoryloupe.codeLensesEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Show codelenses next to symbols in source files"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "memoryloupe",
          "icon": "$(symbol-structure)",
          "title": "MemoryLoupe"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "memoryloupeTreeview",
        "contents": "no tree yet\n[select build dir](command:memoryloupe.selectBuildDir)"
      }
    ],
    "views": {
      "memoryloupe": [
        {
          "id": "memoryloupeTreeview",
          "name": "memoryloupe",
          "icon": "$(list-tree)",
          "contextualTitle": "Symbol tree"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "memoryloupe.refreshTreeview",
          "when": "view == memoryloupeTreeview",
          "group": "navigation"
        },
        {
          "command": "memoryloupe.openMapfile",
          "when": "view == memoryloupeTreeview",
          "group": "navigation"
        },
        {
          "command": "memoryloupe.openMapfile",
          "when": "view == memoryloupeTreeview",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "memoryloupe.goToSymbolSourcefile",
          "when": "view == memoryloupeTreeview && viewItem == symbol",
          "group": "inline"
        },
        {
          "command": "memoryloupe.goToSymbolMapfile",
          "when": "view == memoryloupeTreeview && viewItem == symbol",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "vsix": "npx vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.86.0",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.9",
    "eslint": "^9.35.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.2"
  }
}